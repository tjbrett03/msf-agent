# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# Comma-separated IPs the agent is authorized to attack. Enforced in the runtime.
AUTHORIZED_SCOPE=192.168.56.101

# Ollama (local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT=120
CONTEXT_MAX_MESSAGES=16

# Metasploit RPC (msfrpcd -P msf -U msf -S -a 127.0.0.1)
MSF_HOST=127.0.0.1
MSF_PORT=55553
MSF_USER=msf
MSF_PASS=msf
MSF_SSL=false

# SQLite operational memory
DB_PATH=~/msf-agent/db/agent.db

# NVD API key (optional, raises the rate limit). Leave blank to run unauthenticated.
NVD_API_KEY=

# Agentic loop hard limits
MAX_ITERATIONS=50
MAX_DURATION=3600
